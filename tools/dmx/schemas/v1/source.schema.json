{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Offline unchanged source mesh unit export v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operation",
    "sourceHash",
    "matrixLayout",
    "uvConvention",
    "decodedInputs",
    "bones",
    "members"
  ],
  "properties": {
    "operation": {
      "enum": [
        "export_mesh_unit@1"
      ]
    },
    "sourceHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "matrixLayout": {
      "enum": [
        "column-major"
      ]
    },
    "uvConvention": {
      "enum": [
        "source-unflipped"
      ]
    },
    "decodedInputs": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "bones": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {
        "$ref": "#/definitions/bone"
      }
    },
    "members": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "$ref": "#/definitions/member"
      }
    }
  },
  "definitions": {
    "bone": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "parent",
        "bind",
        "inverse",
        "procedural"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4000000
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "parent": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            {
              "type": "null"
            }
          ]
        },
        "bind": {
          "type": "array",
          "minItems": 16,
          "maxItems": 16,
          "items": {
            "type": "number"
          }
        },
        "inverse": {
          "type": "array",
          "minItems": 16,
          "maxItems": 16,
          "items": {
            "type": "number"
          }
        },
        "procedural": {
          "enum": [
            false
          ]
        }
      }
    },
    "weight": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bone",
        "byte"
      ],
      "properties": {
        "bone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "byte": {
          "type": "integer",
          "minimum": 1,
          "maximum": 255
        }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "position",
        "uv",
        "normal",
        "frameWord",
        "weights"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4000000
        },
        "position": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number"
          }
        },
        "uv": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number"
          }
        },
        "normal": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number"
          }
        },
        "frameWord": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "weights": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "$ref": "#/definitions/weight"
          }
        }
      }
    },
    "face": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "records",
        "material"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4000000
        },
        "records": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4000000
          }
        },
        "material": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_./-]+\\.vmat$"
        }
      }
    },
    "renderBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "inverse"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4000000
        },
        "inverse": {
          "type": "array",
          "minItems": 12,
          "maxItems": 12,
          "items": {
            "type": "number"
          }
        }
      }
    },
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lod",
        "mesh",
        "buffer",
        "records",
        "faces",
        "renderBindings",
        "renderRemap"
      ],
      "properties": {
        "lod": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7
        },
        "mesh": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4000000
        },
        "buffer": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4000000
        },
        "records": {
          "type": "array",
          "minItems": 1,
          "maxItems": 500000,
          "items": {
            "$ref": "#/definitions/record"
          }
        },
        "faces": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000000,
          "items": {
            "$ref": "#/definitions/face"
          }
        },
        "renderBindings": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1024,
          "items": {
            "$ref": "#/definitions/renderBinding"
          }
        },
        "renderRemap": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1024,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4000000
          }
        }
      }
    }
  }
}

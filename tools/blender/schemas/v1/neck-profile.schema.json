{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Offline neck authoring profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["operation", "version", "sceneHash", "head", "body", "outputObject", "headBoundaryVertices", "protectedHeadVertices", "protectedBodyVertices", "cutZ", "blendBounds", "fade", "iterations", "factor", "mergeTolerance", "maxBlendDisplacement", "shadeFade", "view"],
  "properties": {
    "operation": {"const": "neck_author@1"},
    "version": {"type": "integer", "const": 1},
    "sceneHash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "head": {"$ref": "#/definitions/name"},
    "body": {"$ref": "#/definitions/name"},
    "outputObject": {"$ref": "#/definitions/name"},
    "headBoundaryVertices": {"type": "array", "minItems": 3, "maxItems": 512, "uniqueItems": true, "items": {"$ref": "#/definitions/id"}},
    "protectedHeadVertices": {"$ref": "#/definitions/ids"},
    "protectedBodyVertices": {"$ref": "#/definitions/ids"},
    "cutZ": {"type": "number"},
    "blendBounds": {
      "type": "object", "additionalProperties": false, "required": ["min", "max"],
      "properties": {"min": {"$ref": "#/definitions/vector"}, "max": {"$ref": "#/definitions/vector"}}
    },
    "fade": {
      "type": "object", "additionalProperties": false, "required": ["lower", "upper"],
      "properties": {"lower": {"type": "number", "minimum": 0.000001}, "upper": {"type": "number", "minimum": 0.000001}}
    },
    "iterations": {"type": "integer", "minimum": 1, "maximum": 32},
    "factor": {"type": "number", "minimum": 0.000001, "maximum": 1},
    "mergeTolerance": {"type": "number", "minimum": 0.0000001, "maximum": 0.0001},
    "maxBlendDisplacement": {"type": "number", "minimum": 0.000001, "maximum": 30},
    "shadeFade": {
      "type": "object", "additionalProperties": false, "required": ["minZ", "maxZ"],
      "properties": {"minZ": {"type": "number"}, "maxZ": {"type": "number"}}
    },
    "view": {
      "type": "object", "additionalProperties": false, "required": ["center", "scale"],
      "properties": {"center": {"$ref": "#/definitions/vector"}, "scale": {"type": "number", "minimum": 0.000001, "maximum": 10000}}
    }
  },
  "definitions": {
    "name": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[^\\u0000-\\u001f]+$"},
    "id": {"type": "integer", "minimum": 0, "maximum": 199999},
    "ids": {"type": "array", "minItems": 1, "maxItems": 200000, "uniqueItems": true, "items": {"$ref": "#/definitions/id"}},
    "vector": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number", "minimum": -1000000, "maximum": 1000000}}
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "S2ModKit offline geometry authoring policy v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "inputHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "maximumDisplacement": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1000
    },
    "members": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "memberId": {
            "type": "string",
            "pattern": "^lod:[0-9]+/mesh:[0-9]+/buffer:[0-9]+$"
          },
          "protectedIds": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4000000
            }
          }
        },
        "required": [
          "memberId",
          "protectedIds"
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "inputHash",
    "maximumDisplacement",
    "members"
  ]
}

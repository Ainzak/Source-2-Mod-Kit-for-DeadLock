{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "S2ModKit offline geometry authoring preflight v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "kind": {
      "enum": [
        "geometry_authoring_preflight"
      ]
    },
    "inputHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "bundleSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "deltaSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "members": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "memberId": {
            "type": "string",
            "pattern": "^lod:[0-9]+/mesh:[0-9]+/buffer:[0-9]+$"
          },
          "changedRecords": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4000000
          },
          "triangles": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2000000
          },
          "positionPreflight": {
            "enum": [
              "passed"
            ]
          }
        },
        "required": [
          "memberId",
          "changedRecords",
          "triangles",
          "positionPreflight"
        ]
      }
    },
    "compiledWriterQualified": {
      "enum": [
        false
      ]
    },
    "framesQualified": {
      "enum": [
        false
      ]
    },
    "runtimeQualified": {
      "enum": [
        false
      ]
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "inputHash",
    "bundleSha256",
    "deltaSha256",
    "members",
    "compiledWriterQualified",
    "framesQualified",
    "runtimeQualified"
  ]
}

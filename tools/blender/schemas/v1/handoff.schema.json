{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "S2ModKit offline geometry authoring handoff v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "kind": {
      "enum": [
        "geometry_authoring_handoff"
      ]
    },
    "inputHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "snapshotSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "requiredLods": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
      }
    },
    "maximumDisplacement": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1000
    },
    "omittedAttributes": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": [
        {
          "enum": [
            "rig"
          ]
        },
        {
          "enum": [
            "uv"
          ]
        },
        {
          "enum": [
            "weights"
          ]
        },
        {
          "enum": [
            "materials"
          ]
        },
        {
          "enum": [
            "packedFrames"
          ]
        }
      ],
      "additionalItems": false
    },
    "members": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "memberId": {
            "type": "string",
            "pattern": "^lod:[0-9]+/mesh:[0-9]+/buffer:[0-9]+$"
          },
          "lod": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65535
          },
          "mesh": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65535
          },
          "buffer": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65535
          },
          "sourceDecodedHash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "editable": {
            "type": "boolean"
          },
          "positions": {
            "type": "array",
            "minItems": 1,
            "maxItems": 500000,
            "items": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}$"
              }
            }
          },
          "triangles": {
            "type": "array",
            "minItems": 3,
            "maxItems": 6000000,
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4000000
            }
          },
          "protectedIds": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4000000
            }
          }
        },
        "required": [
          "memberId",
          "lod",
          "mesh",
          "buffer",
          "sourceDecodedHash",
          "editable",
          "positions",
          "triangles",
          "protectedIds"
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "inputHash",
    "snapshotSha256",
    "requiredLods",
    "maximumDisplacement",
    "omittedAttributes",
    "members"
  ]
}

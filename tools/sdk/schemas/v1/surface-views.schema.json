{
  "type": "object",
  "properties": {
    "operation": {
      "enum": [
        "sdk_surface_views@1"
      ],
      "type": "string"
    },
    "version": {
      "enum": [
        1
      ],
      "type": "integer"
    },
    "fullCenter": {
      "type": "array",
      "items": {
        "type": "number",
        "minimum": -10000,
        "maximum": 10000
      },
      "minItems": 3,
      "maxItems": 3
    },
    "fullScale": {
      "type": "number",
      "minimum": 0.1,
      "maximum": 1000
    },
    "regionCenter": {
      "type": "array",
      "items": {
        "type": "number",
        "minimum": -10000,
        "maximum": 10000
      },
      "minItems": 3,
      "maxItems": 3
    },
    "regionScale": {
      "type": "number",
      "minimum": 0.1,
      "maximum": 1000
    },
    "directions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,31}$"
          },
          "direction": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": -10000,
              "maximum": 10000
            },
            "minItems": 3,
            "maxItems": 3
          }
        },
        "required": [
          "name",
          "direction"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 6
    },
    "poses": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,31}$"
          },
          "bone": {
            "type": "string",
            "minLength": 1
          },
          "axis": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": -10000,
              "maximum": 10000
            },
            "minItems": 3,
            "maxItems": 3
          },
          "angleDegrees": {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          }
        },
        "required": [
          "name",
          "bone",
          "axis",
          "angleDegrees"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 3
    }
  },
  "required": [
    "operation",
    "version",
    "fullCenter",
    "fullScale",
    "regionCenter",
    "regionScale",
    "directions",
    "poses"

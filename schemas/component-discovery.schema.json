{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://s2modkit.local/schemas/component-discovery.schema.json",
  "title": "S2ModKit paired discovery v7 with strict v2-v6 compatibility",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "model",
    "discoveryFingerprint",
    "analyzer",
    "candidates",
    "lineageDiagnostics",
    "extensions"
  ],
  "properties": {
    "schemaVersion": {
      "enum": [
        2,
        3,
        4,
        5,
        6,
        7
      ]
    },
    "model": {
      "$ref": "#/definitions/modelIdentity"
    },
    "discoveryFingerprint": {
      "$ref": "#/definitions/hash"
    },
    "analyzer": {
      "$ref": "#/definitions/analyzerIdentity"
    },
    "candidates": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "#/definitions/materialGroupCandidate"
          },
          {
            "$ref": "#/definitions/meshLineageCandidate"
          }
        ]
      }
    },
    "lineageDiagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/lineageDiagnostic"
      }
    },
    "extensions": {
      "type": "object"
    },
    "experimentalPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "version"
      ],
      "properties": {
        "kind": {
          "enum": [
            "preserve_unverified"
          ]
        },
        "version": {
          "enum": [
            1
          ]
        }
      }
    }
  },
  "definitions": {
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "modelIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "logicalPath",
        "contentHash",
        "size"
      ],
      "properties": {
        "logicalPath": {
          "type": "string",
          "minLength": 1
        },
        "contentHash": {
          "$ref": "#/definitions/hash"
        },
        "size": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "analyzerIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "componentVersions"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "componentVersions": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "materialGroupCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "candidateId",
        "model",
        "displayLabel",
        "capabilities",
        "extensions",
        "materialPath",
        "lods"
      ],
      "properties": {
        "kind": {
          "enum": [
            "material_group"
          ]
        },
        "candidateId": {
          "type": "string",
          "pattern": "^cmp_[0-9a-f]{24}$"
        },
        "model": {
          "$ref": "#/definitions/modelIdentity"
        },
        "displayLabel": {
          "type": "string",
          "minLength": 1
        },
        "capabilities": {
          "$ref": "#/definitions/capabilities"
        },
        "extensions": {
          "type": "object"
        },
        "materialPath": {
          "type": "string",
          "minLength": 1
        },
        "lods": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/candidateLod"
          }
        }
      }
    },
    "meshLineageCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "candidateId",
        "model",
        "displayLabel",
        "capabilities",
        "extensions",
        "lineageKey",
        "sourceLabel",
        "materialPaths",
        "lods"
      ],
      "properties": {
        "kind": {
          "enum": [
            "mesh_lineage"
          ]
        },
        "candidateId": {
          "type": "string",
          "pattern": "^cmp_[0-9a-f]{24}$"
        },
        "model": {
          "$ref": "#/definitions/modelIdentity"
        },
        "displayLabel": {
          "type": "string",
          "minLength": 1
        },
        "capabilities": {
          "$ref": "#/definitions/capabilities"
        },
        "extensions": {
          "type": "object"
        },
        "lineageKey": {
          "type": "string",
          "minLength": 1
        },
        "sourceLabel": {
          "type": "string",
          "minLength": 1
        },
        "materialPaths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "lods": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/meshLineageLod"
          }
        }
      }
    },
    "candidateLod": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lod",
        "drawCallIds",
        "drawCallCount"
      ],
      "properties": {
        "lod": {
          "type": "integer",
          "minimum": 0
        },
        "drawCallIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^dc_[0-9a-f]{24}$"
          }
        },
        "drawCallCount": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "meshLineageLod": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lod",
        "resourcePath",
        "meshOrdinal",
        "resourceBlockIndex",
        "immutableSemanticHash",
        "sourceName",
        "materialPaths",
        "drawCallIds",
        "drawCallCount"
      ],
      "properties": {
        "lod": {
          "type": "integer",
          "minimum": 0
        },
        "resourcePath": {
          "type": "string",
          "minLength": 1
        },
        "meshOrdinal": {
          "type": "integer",
          "minimum": 0
        },
        "resourceBlockIndex": {
          "type": "integer",
          "minimum": 0
        },
        "immutableSemanticHash": {
          "$ref": "#/definitions/hash"
        },
        "sourceName": {
          "type": "string",
          "minLength": 1
        },
        "materialPaths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "drawCallIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^dc_[0-9a-f]{24}$"
          }
        },
        "drawCallCount": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/capability"
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operationKind",
        "operationVersion",
        "availability",
        "reasons",
        "geometryByLod"
      ],
      "properties": {
        "operationKind": {
          "enum": [
            "remove_component",
            "transform_component"
          ]
        },
        "operationVersion": {
          "enum": [
            1,
            2,
            4,
            5,
            6,
            7,
            8,
            9,
            10
          ]
        },
        "availability": {
          "enum": [
            "available",
            "blocked",
            "unsupported",
            "ambiguous"
          ]
        },
        "reasons": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/reason"
          }
        },
        "geometryByLod": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/geometryLod"
          }
        }
      }
    },
    "reason": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "summary"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "summary": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "geometryLod": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lod",
        "selectedVertexCount",
        "vertexSetHash",
        "exclusivelyOwned"
      ],
      "properties": {
        "lod": {
          "type": "integer",
          "minimum": 0
        },
        "selectedVertexCount": {
          "type": "integer",
          "minimum": 1
        },
        "vertexSetHash": {
          "$ref": "#/definitions/hash"
        },
        "exclusivelyOwned": {
          "type": "boolean"
        }
      }
    },
    "lineageDiagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "summary",
        "observedLods"
      ],
      "properties": {
        "lineageKey": {
          "type": "string",
          "minLength": 1
        },
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "observedLods": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  },
  "allOf": [
    {
      "oneOf": [
        {
          "properties": {
            "schemaVersion": {
              "enum": [
                2
              ]
            },
            "candidates": {
              "items": {
                "properties": {
                  "capabilities": {
                    "items": {
                      "properties": {
                        "operationVersion": {
                          "enum": [
                            1,
                            2,
                            4
                          ]
                        }
                      }
                    },
                    "minItems": 2
                  }
                }
              }
            }
          },
          "not": {
            "required": [
              "experimentalPolicy"
            ]
          }
        },
        {
          "required": [
            "experimentalPolicy"
          ],
          "properties": {
            "schemaVersion": {
              "enum": [
                3
              ]
            },
            "candidates": {
              "items": {
                "properties": {
                  "capabilities": {
                    "items": {
                      "properties": {
                        "operationVersion": {
                          "enum": [
                            1,
                            2,
                            4,
                            5,
                            6
                          ]
                        }
                      }
                    },
                    "minItems": 2
                  }
                }
              }
            }
          }
        },
        {
          "properties": {
            "schemaVersion": {
              "enum": [
                4
              ]
            },
            "candidates": {
              "items": {
                "properties": {
                  "capabilities": {
                    "items": {
                      "properties": {
                        "operationVersion": {
                          "enum": [
                            1,
                            2,
                            4,
                            5,
                            6,
                            7
                          ]
                        }
                      }
                    },
                    "minItems": 2
                  }
                }
              }
            }
          },
          "required": [
            "experimentalPolicy"
          ]
        },
        {
          "properties": {
            "schemaVersion": {
              "enum": [
                5
              ]
            },
            "candidates": {
              "items": {
                "properties": {
                  "capabilities": {
                    "items": {
                      "properties": {
                        "operationVersion": {
                          "enum": [
                            1,
                            2,
                            4,
                            5,
                            6,
                            7,
                            8
                          ]
                        }
                      }
                    },
                    "minItems": 2
                  }
                }
              }
            }
          },
          "required": [
            "experimentalPolicy"
          ]
        },
        {
          "required": [
            "experimentalPolicy"
          ],
          "properties": {
            "schemaVersion": {
              "enum": [
                6
              ]
            }
          }
        },
        {
          "required": [
            "experimentalPolicy"
          ],
          "properties": {
            "schemaVersion": {
              "enum": [
                7
              ]
            },
            "candidates": {
              "items": {
                "properties": {
                  "capabilities": {
                    "minItems": 1,
                    "maxItems": 1
                  }
                }
              }
            }
          }
        }
      ]
    },
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "enum": [
              6
            ]
          }
        }
      },
      "then": {
        "properties": {
          "candidates": {
            "items": {
              "properties": {
                "capabilities": {
                  "items": {
                    "properties": {
                      "operationVersion": {
                        "enum": [
                          1,
                          2,
                          4,
                          5,
                          6,
                          7,
                          8,
                          9
                        ]
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "enum": [
              7
            ]
          }
        }
      },
      "then": {
        "properties": {
          "candidates": {
            "items": {
              "properties": {
                "capabilities": {
                  "items": {
                    "properties": {
                      "operationVersion": {
                        "enum": [
                          10
                        ]
                      },
                      "operationKind": {
                        "enum": [
                          "transform_component"
                        ]
                      },
                      "availability": {
                        "enum": [
                          "unsupported"
                        ]
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}

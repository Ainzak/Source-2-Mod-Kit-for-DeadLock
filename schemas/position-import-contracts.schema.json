        "vertexCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "sourceDecodedHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "sourceEncodedHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "sourceIndexHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "layoutHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "expectedPositionHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "expectedFrameHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "expectedDecodedHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "positionChangeCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "frameClosureIds": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000
          },
          "minItems": 0,
          "maxItems": 1000000,
          "uniqueItems": true
        },
        "frameWords": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/frameWord"
          },
          "minItems": 0,
          "maxItems": 1000000
        },
        "protectedPositionHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "protectedFrameHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "boundaryChangedFrameIds": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000
          },
          "minItems": 0,
          "maxItems": 1000000,
          "uniqueItems": true
        }
      }

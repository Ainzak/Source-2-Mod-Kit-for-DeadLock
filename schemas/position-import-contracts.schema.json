        "preservationTargets": {
          "type": "array",
          "items": {
            "$ref": "paired-contracts.schema.json#/definitions/shared-ellipsoid-contracts-experimentalPreservationTarget"
          },
          "minItems": 0,
          "maxItems": 1000000
        },
        "contextBuffers": {
          "type": "array",
          "maxItems": 1000000,
          "items": {
            "$ref": "paired-contracts.schema.json#/definitions/shared-directional-contracts-directionalContextBuffer"
          },
          "minItems": 1
        },
        "coincidences": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "paired-contracts.schema.json#/definitions/shared-directional-contracts-directionalCoincidenceLod"
          },
          "minItems": 1
        },
        "sourceBlocks": {
          "type": "array",
          "maxItems": 1000000,
          "items": {
            "$ref": "paired-contracts.schema.json#/definitions/shared-ellipsoid-contracts-sourceBlock"

        "sourceWord": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}$"
        },
        "expectedWord": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}$"
        }
      }
    },
    "buffer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "memberId",
        "lod",
        "meshOrdinal",
        "bufferOrdinal",
        "vertexCount",
        "sourceDecodedHash",
        "sourceEncodedHash",
        "sourceIndexHash",
        "layoutHash",
        "expectedPositionHash",
        "expectedFrameHash",

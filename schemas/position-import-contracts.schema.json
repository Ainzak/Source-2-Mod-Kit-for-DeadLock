{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://s2modkit.local/schemas/position-import/v1",
  "title": "Source-bound compiled position import contracts",
  "definitions": {
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bundleSha256",
        "deltaSha256",
        "policySha256",
        "selectionSha256",
        "deltaArtifact"
      ],
      "properties": {
        "bundleSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "deltaSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "policySha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "selectionSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "deltaArtifact": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        }
      }
    },
    "boundaryMap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "memberId",
        "lod",
        "sourceDecodedHash",
        "vertexIds"
      ],
      "properties": {
        "memberId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "lod": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7
        },
        "sourceDecodedHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "vertexIds": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000
          },
          "minItems": 1,
          "maxItems": 1000000,
          "uniqueItems": true
        }
      }
    },
    "boundaryPolicy": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "version"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "const": "keep_positions_and_frames",
              "enum": [
                "keep_positions_and_frames"
              ]
            },
            "version": {
              "type": "integer",
              "const": 1,
              "enum": [
                1
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "version",
            "allowedBoundary"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "const": "keep_positions_allow_source_derived_boundary_frames",
              "enum": [
                "keep_positions_allow_source_derived_boundary_frames"
              ]
            },
            "version": {
              "type": "integer",
              "const": 1,
              "enum": [
                1
              ]
            },
            "allowedBoundary": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/boundaryMap"
              },
              "minItems": 1,
              "maxItems": 128
            }
          }
        }
      ]
    },
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding",
        "members",
        "framePolicy",
        "boundaryFramePolicy",
        "protection"
      ],
      "properties": {
        "binding": {
          "$ref": "#/definitions/binding"
        },
        "members": {
          "type": "array",
          "items": {
            "$ref": "paired-contracts.schema.json#/definitions/shared-coordinated-contracts-coordinatedMember"
          },
          "minItems": 1,
          "maxItems": 16
        },
        "framePolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "version"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "const": "incident_source_differential",
              "enum": [
                "incident_source_differential"
              ]
            },
            "version": {
              "type": "integer",
              "const": 1,
              "enum": [
                1
              ]
            }
          }
        },
        "boundaryFramePolicy": {
          "$ref": "#/definitions/boundaryPolicy"
        },
        "protection": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/boundaryMap"
          },
          "minItems": 1,
          "maxItems": 128
        }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operationId",
        "kind",
        "version",
        "granularity",
        "selector",
        "lodPolicy",
        "expectedMatchesByLod",
        "expectedVerticesByLod",
        "ownershipPolicy",
        "runtimeMetadataPolicy",
        "limits",
        "extensions",
        "zeroBoneBoxPolicy",
        "zeroRenderSpherePolicy",
        "sourceTrianglePolicy",
        "proceduralInputPolicy",
        "positionImport"
      ],
      "properties": {
        "operationId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "kind": {
          "type": "string",
          "const": "import_positions",
          "enum": [
            "import_positions"
          ]
        },
        "version": {
          "type": "integer",
          "const": 1,
          "enum": [
            1
          ]
        },
        "granularity": {
          "type": "string",
          "const": "returned_buffer_positions",
          "enum": [
            "returned_buffer_positions"
          ]
        },
        "selector": {
          "$ref": "paired-contracts.schema.json#/definitions/shared-directional-contracts-coordinatedSelector"
        },
        "lodPolicy": {
          "enum": [
            "all_present"
          ],
          "type": "string"
        },
        "expectedMatchesByLod": {
          "$ref": "paired-contracts.schema.json#/definitions/shared-ellipsoid-contracts-lodExpectations"
        },
        "expectedVerticesByLod": {
          "$ref": "paired-contracts.schema.json#/definitions/shared-ellipsoid-contracts-lodExpectations"
        },
        "ownershipPolicy": {
          "enum": [
            "exclusive"
          ],
          "type": "string"
        },
        "runtimeMetadataPolicy": {
          "$ref": "paired-contracts.schema.json#/definitions/shared-ellipsoid-contracts-runtimeMetadataPolicy"
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "maximumVertexDisplacement"
          ],
          "properties": {
            "maximumVertexDisplacement": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 64
            }
          }
        },
        "extensions": {
          "type": "object",
          "maxProperties": 0
        },
        "zeroBoneBoxPolicy": {
          "$ref": "paired-contracts.schema.json#/definitions/rejectPolicy"
        },
        "zeroRenderSpherePolicy": {
          "$ref": "paired-contracts.schema.json#/definitions/rejectPolicy"
        },
        "sourceTrianglePolicy": {
          "$ref": "paired-contracts.schema.json#/definitions/sourceTrianglePolicy"
        },
        "proceduralInputPolicy": {
          "$ref": "paired-contracts.schema.json#/definitions/proceduralInputPolicy"
        },
        "positionImport": {
          "$ref": "#/definitions/intent"
        }
      }
    },
    "recipe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "recipeId",
        "inputHash",
        "operations",
        "extensions"
      ],
      "properties": {
        "schemaVersion": {
          "type": "integer",
          "const": 12,
          "enum": [
            12
          ]
        },
        "recipeId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "inputHash": {
          "$ref": "paired-contracts.schema.json#/definitions/shared-ellipsoid-contracts-contentHash"
        },
        "operations": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/operation"
          },
          "minItems": 1,
          "maxItems": 1
        },
        "extensions": {
          "type": "object",
          "maxProperties": 0
        }
      }
    },
    "frameWord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vertexId",
        "sourceWord",
        "expectedWord"
      ],
      "properties": {
        "vertexId": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000

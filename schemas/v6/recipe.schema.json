{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://s2modkit.local/schemas/recipe.schema.json",
  "title": "S2ModKit recipe v6 (strict v5 compatibility)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "recipeId", "inputHash", "operations", "extensions"],
  "properties": {
    "schemaVersion": { "enum": [5, 6] },
    "recipeId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
    "inputHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          { "$ref": "#/definitions/removeComponent" },
          { "$ref": "#/definitions/transformComponent" },
          { "$ref": "#/definitions/coupledTransformComponent" },
          { "$ref": "#/definitions/connectedComponentTransform" },
          { "$ref": "#/definitions/affineDrawCallTransform" },
          { "$ref": "#/definitions/affineConnectedComponentTransform" },
          { "$ref": "#/definitions/experimentalVisualTransform" }
        ]
      }
    },
    "extensions": { "type": "object" }
  },
  "oneOf": [
    {
      "properties": {
        "schemaVersion": { "enum": [6] },
        "operations": { "maxItems": 1, "items": { "$ref": "#/definitions/experimentalVisualTransform" } }
      }
    },
    {
      "properties": {
        "schemaVersion": { "enum": [5] },
        "operations": { "items": { "not": { "properties": { "version": { "enum": [5] } }, "required": ["version"] } } }
      }
    }
  ],
  "definitions": {
    "experimentalVisualTransform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operationId", "kind", "version", "granularity", "selector", "lodPolicy", "expectedMatchesByLod", "expectedVerticesByLod", "ownershipPolicy", "runtimeMetadataPolicy", "transform", "limits", "extensions"],
      "properties": {
        "operationId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
        "kind": { "enum": ["transform_component"] },
        "version": { "enum": [5] },
        "granularity": { "enum": ["draw_call_vertices"] },
        "selector": { "$ref": "#/definitions/selector" },
        "lodPolicy": { "enum": ["all_present"] },
        "expectedMatchesByLod": { "$ref": "#/definitions/lodExpectations" },
        "expectedVerticesByLod": { "$ref": "#/definitions/lodExpectations" },
        "ownershipPolicy": { "enum": ["exclusive"] },
        "runtimeMetadataPolicy": {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "version"],
          "properties": { "kind": { "enum": ["preserve_unverified"] }, "version": { "enum": [1] } }
        },
        "transform": {
          "type": "object", "additionalProperties": false,
          "required": ["pivot", "uniformScale", "translation"],
          "properties": {
            "pivot": { "$ref": "#/definitions/affinePivot" },
            "uniformScale": { "type": "number", "minimum": 0.5, "maximum": 2, "not": { "enum": [1] } },
            "translation": {
              "type": "object", "additionalProperties": false, "required": ["x", "y", "z"],
              "properties": { "x": { "enum": [0] }, "y": { "enum": [0] }, "z": { "enum": [0] } }
            }
          }
        },
        "limits": {
          "type": "object", "additionalProperties": false, "required": ["maximumVertexDisplacement"],
          "properties": { "maximumVertexDisplacement": { "type": "number", "exclusiveMinimum": 0, "maximum": 64 } }
        },
        "extensions": { "type": "object" }
      }
    },
    "removeComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operationId", "kind", "version", "granularity", "selector", "lodPolicy", "expectedMatchesByLod", "extensions"],
      "properties": {
        "operationId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
        "kind": { "enum": ["remove_component"] },
        "version": { "enum": [1] },
        "granularity": { "enum": ["draw_call"] },
        "selector": { "$ref": "#/definitions/selector" },
        "lodPolicy": { "enum": ["all_present"] },
        "expectedMatchesByLod": { "$ref": "#/definitions/lodExpectations" },
        "extensions": { "type": "object" }
      }
    },
    "transformComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operationId", "kind", "version", "granularity", "selector", "lodPolicy", "expectedMatchesByLod", "expectedVerticesByLod", "ownershipPolicy", "transform", "limits", "extensions"],
      "properties": {
        "operationId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
        "kind": { "enum": ["transform_component"] },
        "version": { "enum": [1] },
        "granularity": { "enum": ["draw_call_owned_vertices"] },
        "selector": { "$ref": "#/definitions/selector" },
        "lodPolicy": { "enum": ["all_present"] },
        "expectedMatchesByLod": { "$ref": "#/definitions/lodExpectations" },
        "expectedVerticesByLod": { "$ref": "#/definitions/lodExpectations" },
        "ownershipPolicy": { "enum": ["exclusive"] },
        "transform": { "$ref": "#/definitions/transform" },
        "limits": { "$ref": "#/definitions/limitsV1" },
        "extensions": { "type": "object" }
      }
    },
    "coupledTransformComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operationId", "kind", "version", "granularity", "selector", "lodPolicy", "expectedMatchesByLod", "expectedVerticesByLod", "ownershipPolicy", "physicsPolicy", "transform", "limits", "extensions"],
      "properties": {
        "operationId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
        "kind": { "enum": ["transform_component"] },
        "version": { "enum": [2] },
        "granularity": { "enum": ["draw_call_owned_vertices"] },
        "selector": { "$ref": "#/definitions/selector" },
        "lodPolicy": { "enum": ["all_present"] },
        "expectedMatchesByLod": { "$ref": "#/definitions/lodExpectations" },
        "expectedVerticesByLod": { "$ref": "#/definitions/lodExpectations" },
        "ownershipPolicy": { "enum": ["exclusive"] },
        "physicsPolicy": { "enum": ["transform_coupled_convex"] },
        "transform": { "$ref": "#/definitions/coupledTransform" },
        "limits": { "$ref": "#/definitions/limitsV2" },
        "extensions": { "type": "object" }
      }
    },
    "connectedComponentTransform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operationId", "kind", "version", "granularity", "selector", "lodPolicy", "expectedMatchesByLod", "expectedVerticesByLod", "connectedComponentIdsByLod", "ownershipPolicy", "transform", "limits", "extensions"],
      "properties": {
        "operationId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
        "kind": { "enum": ["transform_component"] },
        "version": { "enum": [3] },
        "granularity": { "enum": ["connected_component_vertices"] },
        "selector": { "$ref": "#/definitions/selector" },
        "lodPolicy": { "enum": ["all_present"] },
        "expectedMatchesByLod": { "$ref": "#/definitions/lodExpectations" },
        "expectedVerticesByLod": { "$ref": "#/definitions/lodExpectations" },
        "connectedComponentIdsByLod": { "$ref": "#/definitions/connectedComponentIdsByLod" },
        "ownershipPolicy": { "enum": ["exclusive"] },
        "transform": { "$ref": "#/definitions/transform" },
        "limits": { "$ref": "#/definitions/limitsV1" },
        "extensions": { "type": "object" }
      }
    },
    "affineDrawCallTransform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operationId", "kind", "version", "granularity", "selector", "lodPolicy", "expectedMatchesByLod", "expectedVerticesByLod", "ownershipPolicy", "transform", "limits", "extensions"],
      "properties": {
        "operationId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
        "kind": { "enum": ["transform_component"] },
        "version": { "enum": [4] },
        "granularity": { "enum": ["draw_call_vertices"] },
        "selector": { "$ref": "#/definitions/selector" },
        "lodPolicy": { "enum": ["all_present"] },
        "expectedMatchesByLod": { "$ref": "#/definitions/lodExpectations" },
        "expectedVerticesByLod": { "$ref": "#/definitions/lodExpectations" },
        "ownershipPolicy": { "enum": ["exclusive"] },
        "transform": { "$ref": "#/definitions/affineTransform" },
        "limits": { "$ref": "#/definitions/limitsV1" },
        "extensions": { "type": "object" }
      }
    },
    "affineConnectedComponentTransform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operationId", "kind", "version", "granularity", "selector", "lodPolicy", "expectedMatchesByLod", "expectedVerticesByLod", "connectedComponentIdsByLod", "ownershipPolicy", "transform", "limits", "extensions"],
      "properties": {
        "operationId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
        "kind": { "enum": ["transform_component"] },
        "version": { "enum": [4] },
        "granularity": { "enum": ["connected_component_vertices"] },
        "selector": { "$ref": "#/definitions/selector" },
        "lodPolicy": { "enum": ["all_present"] },
        "expectedMatchesByLod": { "$ref": "#/definitions/lodExpectations" },
        "expectedVerticesByLod": { "$ref": "#/definitions/lodExpectations" },
        "connectedComponentIdsByLod": { "$ref": "#/definitions/connectedComponentIdsByLod" },
        "ownershipPolicy": { "enum": ["exclusive"] },
        "transform": { "$ref": "#/definitions/affineTransform" },
        "limits": { "$ref": "#/definitions/limitsV1" },
        "extensions": { "type": "object" }
      }
    },
    "selector": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "materialPath"],
          "properties": {
            "kind": { "enum": ["material_exact"] },
            "materialPath": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "drawCallIds"],
          "properties": {
            "kind": { "enum": ["draw_call_ids"] },
            "drawCallIds": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "pattern": "^dc_[0-9a-f]{24}$" }
            }
          }
        }
      ]
    },
    "lodExpectations": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "patternProperties": {
        "^(0|[1-9][0-9]*)$": { "type": "integer", "minimum": 1 }
      }
    },
    "connectedComponentIdsByLod": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "patternProperties": {
        "^(0|[1-9][0-9]*)$": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^cc_[0-9a-f]{24}$" }
        }
      }
    },
    "transform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pivot", "uniformScale", "translation"],
      "properties": {
        "pivot": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "referenceLod"],
          "properties": {
            "kind": { "enum": ["selection_bounds_center"] },
            "referenceLod": { "type": "integer", "minimum": 0 }
          }
        },
        "uniformScale": { "type": "number", "minimum": 0.25, "maximum": 4.0 },
        "translation": { "$ref": "#/definitions/vector3" }
      },
      "not": {
        "properties": {
          "uniformScale": { "enum": [1.0] },
          "translation": {
            "properties": {
              "x": { "enum": [0.0] },
              "y": { "enum": [0.0] },
              "z": { "enum": [0.0] }
            },
            "required": ["x", "y", "z"]
          }
        },
        "required": ["uniformScale", "translation"]
      }
    },
    "vector3": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "z"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "z": { "type": "number" }
      }
    },
    "coupledTransform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pivot", "uniformScale", "translation"],
      "properties": {
        "pivot": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "referenceLod"],
          "properties": {
            "kind": { "enum": ["selection_bounds_center"] },
            "referenceLod": { "type": "integer", "minimum": 0 }
          }
        },
        "uniformScale": { "type": "number", "minimum": 0.25, "maximum": 4.0, "not": { "enum": [1.0] } },
        "translation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "y", "z"],
          "properties": { "x": { "enum": [0.0] }, "y": { "enum": [0.0] }, "z": { "enum": [0.0] } }
        }
      }
    },
    "affineTransform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pivot", "scale", "rotation", "frame", "translation"],
      "properties": {
        "pivot": { "$ref": "#/definitions/affinePivot" },
        "scale": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "y", "z"],
          "properties": {
            "x": { "type": "number", "minimum": 0.25, "maximum": 4.0 },
            "y": { "type": "number", "minimum": 0.25, "maximum": 4.0 },
            "z": { "type": "number", "minimum": 0.25, "maximum": 4.0 }
          }
        },
        "rotation": { "$ref": "#/definitions/affineRotation" },
        "frame": { "$ref": "#/definitions/affineFrame" },
        "translation": { "$ref": "#/definitions/vector3" }
      },
      "not": {
        "properties": {
          "scale": {
            "properties": { "x": { "enum": [1.0] }, "y": { "enum": [1.0] }, "z": { "enum": [1.0] } },
            "required": ["x", "y", "z"]
          },
          "rotation": { "properties": { "kind": { "enum": ["identity"] } }, "required": ["kind"] },
          "translation": {
            "properties": { "x": { "enum": [0.0] }, "y": { "enum": [0.0] }, "z": { "enum": [0.0] } },
            "required": ["x", "y", "z"]
          }
        },
        "required": ["scale", "rotation", "translation"]
      }
    },
    "affinePivot": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "referenceLod"],
          "properties": { "kind": { "enum": ["selection_bounds_center"] }, "referenceLod": { "type": "integer", "minimum": 0 } }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "point"],
          "properties": { "kind": { "enum": ["explicit_point"] }, "point": { "$ref": "#/definitions/vector3" } }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "referenceLod", "face"],
          "properties": {
            "kind": { "enum": ["bounds_face"] },
            "referenceLod": { "type": "integer", "minimum": 0 },
            "face": { "enum": ["min_x", "max_x", "min_y", "max_y", "min_z", "max_z"] }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "referenceLod", "boneName"],
          "properties": {
            "kind": { "enum": ["bone_origin"] },
            "referenceLod": { "type": "integer", "minimum": 0 },
            "boneName": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "affineRotation": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind"], "properties": { "kind": { "enum": ["identity"] } }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "axis", "degrees"],
          "properties": {
            "kind": { "enum": ["axis_angle"] },
            "axis": { "$ref": "#/definitions/vector3" },
            "degrees": { "type": "number", "exclusiveMinimum": -180.0, "maximum": 180.0, "not": { "enum": [0.0] } }
          }
        }
      ]
    },
    "affineFrame": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind"], "properties": { "kind": { "enum": ["model"] } }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "boneName"],
          "properties": { "kind": { "enum": ["bone_bind"] }, "boneName": { "type": "string", "minLength": 1 } }
        }
      ]
    },
    "limitsV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maximumVertexDisplacement"],
      "properties": {
        "maximumVertexDisplacement": { "type": "number", "exclusiveMinimum": 0, "maximum": 256.0 }
      }
    },
    "limitsV2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maximumVertexDisplacement", "maximumCollisionDisplacement"],
      "properties": {
        "maximumVertexDisplacement": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 256.0
        },
        "maximumCollisionDisplacement": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 256.0
        }
      }
    }
  }
}

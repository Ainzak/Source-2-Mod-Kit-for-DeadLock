{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://s2modkit.local/schemas/coordinated-contracts/v1",
  "title": "S2ModKit coordinated visual contracts",
  "definitions": {
    "plannedCoordinatedTransformTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inputHash",
        "targetFingerprint",
        "structuralProfileId",
        "structuralProfileVersion",
        "boundsPolicyId",
        "boundsPolicyVersion",
        "runtimeMetadataPolicy",
        "zeroBoneBoxPolicy",
        "zeroRenderSpherePolicy",
        "selector",
        "coordinatedTransform",
        "fieldProof",
        "maximumDisplacement",
        "displacementLimit",
        "buffers",
        "boxTargets",
        "zeroBoxTargets",
        "zeroRenderSphereTargets",
        "preservationTargets",
        "sourceBlocks",
        "seamInventory"
      ],
      "properties": {
        "inputHash": {
          "$ref": "ellipsoid-contracts.schema.json#/definitions/contentHash"
        },
        "targetFingerprint": {
          "$ref": "ellipsoid-contracts.schema.json#/definitions/contentHash"
        },
        "structuralProfileId": {
          "enum": [
            "root_coordinated_fields_visual"
          ]
        },
        "structuralProfileVersion": {
          "enum": [
            1
          ]
        },
        "boundsPolicyId": {
          "enum": [
            "retain_expand_boxes_preserve_runtime_coordinated"
          ]
        },
        "boundsPolicyVersion": {
          "enum": [
            1
          ]
        },
        "runtimeMetadataPolicy": {
          "$ref": "ellipsoid-contracts.schema.json#/definitions/runtimeMetadataPolicy"
        },
        "zeroBoneBoxPolicy": {
          "$ref": "#/definitions/zeroBoneBoxPolicy"
        },
        "zeroRenderSpherePolicy": {
          "$ref": "#/definitions/zeroRenderSpherePolicy"
        },
        "selector": {
          "$ref": "#/definitions/coordinatedSelector"
        },
        "coordinatedTransform": {
          "$ref": "#/definitions/coordinatedVisualTransform"
        },
        "fieldProof": {
          "$ref": "#/definitions/plannedCoordinatedFieldProof"
        },
        "maximumDisplacement": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 64
        },
        "displacementLimit": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 64
        },
        "buffers": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/plannedCoordinatedBuffer"
          },
          "minItems": 2,
          "maxItems": 128
        },
        "boxTargets": {
          "type": "array",
          "items": {
            "$ref": "ellipsoid-contracts.schema.json#/definitions/experimentalBoxTarget"
          },
          "minItems": 0
        },
        "zeroBoxTargets": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/plannedZeroBoneBoxPreservationTarget"
          },
          "minItems": 0
        },
        "zeroRenderSphereTargets": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/plannedZeroRenderSpherePreservationTarget"
          },
          "minItems": 0
        },
        "preservationTargets": {
          "type": "array",
          "items": {
            "$ref": "ellipsoid-contracts.schema.json#/definitions/experimentalPreservationTarget"
          },
          "minItems": 0
        },
        "sourceBlocks": {
          "type": "array",
          "items": {
            "$ref": "ellipsoid-contracts.schema.json#/definitions/sourceBlock"
          },
          "minItems": 0
        },
        "seamInventory": {
          "$ref": "#/definitions/plannedCoordinatedSeamInventory"
        }
      }
    },
    "zeroBoneBoxPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "version"
      ],
      "properties": {
        "kind": {
          "enum": [
            "reject",
            "preserve_all_zero_single_contributor_unverified"
          ]
        },
        "version": {
          "enum": [
            1
          ]
        }
      }
    },
    "zeroRenderSpherePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "version"
      ],
      "properties": {
        "kind": {
          "enum": [
            "reject",
            "preserve_zero_render_sphere_with_zero_box_unverified"
          ]
        },
        "version": {
          "enum": [
            1
          ]
        }
      }
    },
    "coordinatedVisualTransform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "members",
        "field"
      ],
      "properties": {
        "members": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/coordinatedMember"
          },
          "minItems": 2,
          "maxItems": 16
        },
        "field": {
          "oneOf": [
            {
              "$ref": "#/definitions/coordinatedEllipsoidField"
            },
            {
              "$ref": "#/definitions/coordinatedAxisRampField"
            },
            {
              "$ref": "#/definitions/coordinatedTiltedRampField"
            }
          ]
        }
      }
    },
    "coordinatedMember": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "memberId",
        "lods"
      ],
      "properties": {
        "memberId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "lods": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/coordinatedMemberLod"
          },
          "minItems": 1,
          "maxItems": 8
        }
      }
    },
    "coordinatedMemberLod": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lod",
        "drawCallIds",
        "expectedVertices"
      ],
      "properties": {
        "lod": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7
        },
        "drawCallIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^dc_[0-9a-f]{24}$"
          },
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true
        },
        "expectedVertices": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        }
      }
    },
    "coordinatedEllipsoidField": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intent",
        "version",
        "coordinateSpace",
        "kind"
      ],
      "properties": {
        "intent": {
          "allOf": [
            {
              "$ref": "ellipsoid-contracts.schema.json#/definitions/localTransform"
            },
            {
              "properties": {
                "field": {
                  "properties": {
                    "kind": {
                      "enum": [
                        "ellipsoid"
                      ]
                    }
                  },
                  "not": {
                    "required": [
                      "mirrorPlane"
                    ]
                  }
                }
              }
            }
          ]
        },
        "version": {
          "enum": [
            1
          ]
        },
        "coordinateSpace": {
          "enum": [
            "model"
          ]
        },
        "kind": {
          "enum": [
            "ellipsoid"
          ]
        }
      }
    },
    "coordinatedAxisRampField": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "axis",
        "pinnedThrough",
        "fullFrom",
        "pivot",
        "uniformScale",
        "version",
        "coordinateSpace",
        "kind"
      ],
      "properties": {
        "axis": {
          "enum": [
            "x",
            "y",
            "z"
          ]
        },
        "pinnedThrough": {
          "type": "number"
        },
        "fullFrom": {
          "type": "number"
        },
        "pivot": {
          "$ref": "ellipsoid-contracts.schema.json#/definitions/vector3"
        },
        "uniformScale": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 2,
          "not": {
            "enum": [
              1
            ]
          }
        },
        "version": {
          "enum": [
            1
          ]
        },
        "coordinateSpace": {
          "enum": [
            "model"
          ]
        },
        "kind": {
          "enum": [
            "axis_ramp"
          ]
        }
      }
    },
    "coordinatedTiltedRampField": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "firstAxis",
        "firstSign",
        "secondAxis",
        "secondSign",
        "pinnedThrough",
        "fullFrom",
        "pivot",
        "uniformScale",
        "numericalPolicy",
        "version",
        "coordinateSpace",
        "kind"
      ],
      "properties": {
        "firstAxis": {
          "enum": [
            "x",
            "y",
            "z"
          ]
        },
        "firstSign": {
          "enum": [
            -1,
            1
          ]
        },
        "secondAxis": {
          "enum": [
            "x",
            "y",
            "z"
          ]
        },
        "secondSign": {
          "enum": [
            -1,
            1
          ]
        },
        "pinnedThrough": {
          "type": "number"
        },
        "fullFrom": {
          "type": "number"
        },
        "pivot": {
          "$ref": "ellipsoid-contracts.schema.json#/definitions/vector3"
        },
        "uniformScale": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 2,
          "not": {
            "enum": [
              1
            ]
          }
        },
        "numericalPolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "version"
          ],
          "properties": {
            "kind": {
              "enum": [
                "tilted_ramp_numeric"
              ]
            },
            "version": {
              "enum": [
                1
              ]
            }
          }
        },
        "version": {
          "enum": [
            1
          ]
        },
        "coordinateSpace": {
          "enum": [
            "model"
          ]
        },
        "kind": {
          "enum": [
            "tilted_ramp"
          ]
        }
      }
    },
    "ellipsoidNumericalPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "version"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        }
      }
    },
    "plannedCoordinatedFieldProof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "version",
        "ellipsoidCertificate",
        "tiltedCertificate"
      ],
      "properties": {
        "kind": {
          "enum": [
            "ellipsoid",
            "axis_ramp",
            "tilted_ramp"
          ]
        },
        "version": {
          "enum": [
            1
          ]
        },
        "ellipsoidCertificate": {
          "oneOf": [
            {
              "$ref": "ellipsoid-contracts.schema.json#/definitions/certificate"
            },
            {
              "type": "null"
            }
          ]
        },
        "tiltedCertificate": {
          "oneOf": [
            {
              "$ref": "#/definitions/plannedTiltedRampCertificate"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "oneOf": [
            {
              "properties": {
                "kind": {
                  "enum": [
                    "ellipsoid"
                  ]
                },
                "tiltedCertificate": {
                  "type": "null"
                },
                "ellipsoidCertificate": {
                  "$ref": "ellipsoid-contracts.schema.json#/definitions/certificate"
                }
              }
            },
            {
              "properties": {
                "kind": {
                  "enum": [
                    "tilted_ramp"
                  ]
                },
                "tiltedCertificate": {
                  "$ref": "#/definitions/plannedTiltedRampCertificate"
                },
                "ellipsoidCertificate": {
                  "type": "null"
                }
              }
            },
            {
              "properties": {
                "kind": {
                  "enum": [
                    "axis_ramp"
                  ]
                },
                "tiltedCertificate": {
                  "type": "null"
                },
                "ellipsoidCertificate": {
                  "type": "null"
                }
              }
            }
          ]
        }
      ]
    },
    "plannedTiltedRampCertificate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "version",
        "numerator",
        "denominator"
      ],
      "properties": {
        "algorithm": {
          "enum": [
            "signed_two_axis_adverse_bound"
          ]
        },
        "version": {
          "enum": [
            1
          ]
        },
        "numerator": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "denominator": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        }
      }
    },
    "plannedCoordinatedBuffer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "memberId",
        "lod",
        "resourcePath",
        "meshOrdinal",
        "resourceBlockIndex",
        "vertexBufferOrdinal",
        "indexBufferOrdinal",
        "vertexResourceBlockIndex",
        "indexResourceBlockIndex",
        "vertexBlockInputHash",
        "indexBlockInputHash",
        "inputDecodedVertexBufferHash",
        "expectedDecodedVertexBufferHash",
        "decodedIndexBufferHash",
        "vertexSetHash",
        "vertexCount",
        "ownershipPolicy",
        "positionLayout",
        "packedFrameLayout",
        "codec",
        "maskHash",
        "weightHash",
        "fullVertexCount",
        "transitionVertexCount",
        "pinnedVertexCount",
        "changedPositionCount",
        "changedFrameCount",
        "inputPositionHash",
        "expectedPositionHash",
        "inputPackedFrameHash",
        "expectedPackedFrameHash",
        "beforeBounds",
        "expectedAfterBounds",
        "maximumDisplacement"
      ],
      "properties": {
        "memberId": {
          "type": "string",
          "minLength": 1
        },
        "lod": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "resourcePath": {
          "type": "string",
          "minLength": 1
        },
        "meshOrdinal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "resourceBlockIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "vertexBufferOrdinal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "indexBufferOrdinal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "vertexResourceBlockIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "indexResourceBlockIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "vertexBlockInputHash": {
          "$ref": "ellipsoid-contracts.schema.json#/definitions/contentHash"
        },
        "indexBlockInputHash": {
          "$ref": "ellipsoid-contracts.schema.json#/definitions/contentHash"
        },
        "inputDecodedVertexBufferHash": {
          "$ref": "ellipsoid-contracts.schema.json#/definitions/contentHash"
        },
        "expectedDecodedVertexBufferHash": {
          "$ref": "ellipsoid-contracts.schema.json#/definitions/contentHash"
        },
        "decodedIndexBufferHash": {
          "$ref": "ellipsoid-contracts.schema.json#/definitions/contentHash"
        },
        "vertexSetHash": {
          "$ref": "ellipsoid-contracts.schema.json#/definitions/contentHash"
        },
        "vertexCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "ownershipPolicy": {
          "type": "string",
          "minLength": 1
        },
        "positionLayout": {
          "$ref": "ellipsoid-contracts.schema.json#/definitions/positionLayout"
        },
        "packedFrameLayout": {
          "$ref": "ellipsoid-contracts.schema.json#/definitions/packedFrameLayout"
        },
        "codec": {
          "$ref": "ellipsoid-contracts.schema.json#/definitions/codecIdentity"
        },
        "maskHash": {
          "$ref": "ellipsoid-contracts.schema.json#/definitions/contentHash"
        },
        "weightHash": {
          "$ref": "ellipsoid-contracts.schema.json#/definitions/contentHash"
        },
        "fullVertexCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "transitionVertexCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "pinnedVertexCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "changedPositionCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "changedFrameCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "inputPositionHash": {
          "$ref": "ellipsoid-contracts.schema.json#/definitions/contentHash"
        },
        "expectedPositionHash": {
          "$ref": "ellipsoid-contracts.schema.json#/definitions/contentHash"
        },
        "inputPackedFrameHash": {
          "$ref": "ellipsoid-contracts.schema.json#/definitions/contentHash"
        },
        "expectedPackedFrameHash": {
          "$ref": "ellipsoid-contracts.schema.json#/definitions/contentHash"
        },
        "beforeBounds": {
          "$ref": "ellipsoid-contracts.schema.json#/definitions/bounds"
        },
        "expectedAfterBounds": {
          "$ref": "ellipsoid-contracts.schema.json#/definitions/bounds"
        },
        "maximumDisplacement": {
          "type": "number"
        }
      }
    },
    "plannedZeroBoneBoxPreservationTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lod",
        "meshOrdinal",
        "boneIndex",
        "resourceBlockIndex",
        "fieldPath",
        "storage",
        "coordinateSpace",
        "coordinateMatrixHash",
        "coordinateMatrixWords",
        "contributorSetHash",
        "contributorCount",
        "contributorMeshVertexIndex",
        "sourcePayloadHash",
        "originalWords",
        "policy",
        "disposition"
      ],
      "properties": {
        "lod": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "meshOrdinal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "boneIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "resourceBlockIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "fieldPath": {
          "type": "string",
          "minLength": 1
        },
        "storage": {
          "enum": [
            "center_half_extent_f32"
          ]
        },
        "coordinateSpace": {
          "enum": [
            "render_inverse_bind"
          ]
        },
        "coordinateMatrixHash": {
          "$ref": "ellipsoid-contracts.schema.json#/definitions/contentHash"
        },
        "coordinateMatrixWords": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          },
          "minItems": 12,
          "maxItems": 12
        },
        "contributorSetHash": {
          "$ref": "ellipsoid-contracts.schema.json#/definitions/contentHash"
        },
        "contributorCount": {
          "enum": [
            1
          ]
        },
        "contributorMeshVertexIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "sourcePayloadHash": {
          "$ref": "ellipsoid-contracts.schema.json#/definitions/contentHash"
        },
        "originalWords": {
          "type": "array",
          "items": {
            "enum": [
              0
            ]
          },
          "minItems": 6,
          "maxItems": 6
        },
        "policy": {
          "$ref": "#/definitions/zeroBoneBoxPolicy"
        },
        "disposition": {
          "enum": [
            "preserve_unverified"
          ]
        }
      }
    },
    "plannedZeroRenderSpherePreservationTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resourceBlockIndex",
        "fieldPath",
        "pairedZeroBoxFieldPath",
        "contributorSetHash",
        "sourcePayloadHash",
        "storage",
        "originalWord",
        "policy",
        "disposition"
      ],
      "properties": {
        "resourceBlockIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "fieldPath": {
          "type": "string",
          "minLength": 1
        },
        "pairedZeroBoxFieldPath": {
          "type": "string",
          "minLength": 1
        },
        "contributorSetHash": {
          "$ref": "ellipsoid-contracts.schema.json#/definitions/contentHash"
        },
        "sourcePayloadHash": {
          "$ref": "ellipsoid-contracts.schema.json#/definitions/contentHash"
        },
        "storage": {
          "enum": [
            "binary32",
            "binary64"
          ]
        },
        "originalWord": {
          "enum": [
            0
          ]
        },
        "policy": {
          "$ref": "#/definitions/zeroRenderSpherePolicy"
        },
        "disposition": {
          "enum": [
            "preserve_unverified"
          ]
        }
      }
    },
    "plannedCoordinatedSeamInventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "completeSourcePositionIdentity",
        "selectedRecordCount",
        "movingCohortCount",
        "coincidentSelectedRecordCount",
        "excludedMovingMates"
      ],
      "properties": {
        "completeSourcePositionIdentity": {
          "$ref": "ellipsoid-contracts.schema.json#/definitions/contentHash"
        },
        "selectedRecordCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "movingCohortCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "coincidentSelectedRecordCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "excludedMovingMates": {
          "enum": [
            0
          ]
        }
      }
    },
    "coordinatedTransformEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "observedBuffers",
        "boxes",
        "zeroBoxes",
        "zeroRenderSpheres",
        "preservedMetadata"
      ],
      "properties": {
        "target": {
          "$ref": "#/definitions/plannedCoordinatedTransformTarget"
        },
        "observedBuffers": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/definitions/coordinatedBufferObservation"
              },
              "minItems": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "boxes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/experimentalBoxEvidence"
          },
          "minItems": 0
        },
        "zeroBoxes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/zeroBoneBoxPreservationEvidence"
          },
          "minItems": 0
        },
        "zeroRenderSpheres": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/zeroRenderSpherePreservationEvidence"
          },
          "minItems": 0
        },

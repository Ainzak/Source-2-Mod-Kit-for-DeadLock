{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://s2modkit.local/schemas/project.schema.json",
  "title": "S2ModKit project manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "projectId", "createdUtc", "input", "dependencyGraphComplete", "dependencies", "dependencyEdges", "resourceRoots", "runtimeResourceRoots", "extensions"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "projectId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
    "createdUtc": { "type": "string", "format": "date-time" },
    "input": { "$ref": "#/definitions/artifact" },
    "dependencyGraphComplete": { "const": true },
    "dependencies": {
      "type": "array",
      "items": { "$ref": "#/definitions/artifact" }
    },
    "dependencyEdges": {
      "type": "array",
      "items": { "$ref": "#/definitions/dependencyEdge" }
    },
    "resourceRoots": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "runtimeResourceRoots": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "extensions": { "type": "object" }
  },
  "definitions": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logicalPath", "contentHash", "size", "objectRelativePath", "sourcePath", "provenanceKind", "sourceKind", "catalogIdentity", "verificationMode"],
      "properties": {
        "logicalPath": { "type": "string", "minLength": 1 },
        "contentHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "size": { "type": "integer", "minimum": 0 },
        "objectRelativePath": { "type": "string", "minLength": 1 },
        "sourcePath": { "type": "string", "minLength": 1 },
        "provenanceKind": { "enum": ["owned", "runtime_provided"] },
        "sourceKind": { "enum": ["directory", "vpk"] },
        "catalogIdentity": { "type": "string", "minLength": 1 },
        "verificationMode": { "type": "string", "minLength": 1 }
      }
    },
    "dependencyEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fromLogicalPath", "toLogicalPath", "referenceId"],
      "properties": {
        "fromLogicalPath": { "type": "string", "minLength": 1 },
        "toLogicalPath": { "type": "string", "minLength": 1 },
        "referenceId": { "type": "string", "pattern": "^[0-9a-f]{16}$" }
      }
    }
  }
}

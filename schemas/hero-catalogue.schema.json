{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://s2modkit.local/schemas/hero-catalogue.schema.json",
  "title": "S2ModKit hero catalogue v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "catalogueId", "revision", "source", "heroes", "extensions"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "catalogueId": { "$ref": "#/definitions/portableId" },
    "revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "source": { "$ref": "#/definitions/source" },
    "heroes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": { "$ref": "#/definitions/hero" }
    },
    "extensions": { "type": "object" }
  },
  "definitions": {
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "portableId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gameId", "sourceKind"],
      "properties": {
        "gameId": { "const": "deadlock" },
        "sourceKind": { "const": "base_vpk" },
        "gameBuild": { "type": "string", "minLength": 1, "maxLength": 128 },
        "expectedDirectoryHash": { "$ref": "#/definitions/hash" }
      }
    },
    "hero": {
      "type": "object",
      "additionalProperties": false,
      "required": ["heroId", "displayName", "aliases", "rosterStatus", "resources", "extensions"],
      "properties": {
        "heroId": { "$ref": "#/definitions/portableId" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 128 },
        "aliases": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 128 }
        },
        "rosterStatus": { "enum": ["active", "experimental", "unavailable"] },
        "resources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "$ref": "#/definitions/resource" }
        },
        "extensions": { "type": "object" }
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resourceId", "displayName", "role", "logicalPath", "optional", "qualificationStatus", "extensions"],
      "properties": {
        "resourceId": { "$ref": "#/definitions/portableId" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 128 },
        "role": { "enum": ["primary_model", "accessory_model", "variant_model"] },
        "logicalPath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^[a-z0-9][a-z0-9_./-]*\\.vmdl_c$"
        },
        "optional": { "type": "boolean" },
        "qualificationStatus": {
          "enum": ["unqualified", "read_only_qualified", "offline_static", "runtime_qualified"]
        },
        "extensions": { "type": "object" }
      }
    }
  }
}
